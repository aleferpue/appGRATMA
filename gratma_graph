# -*- coding: utf-8 -*-
"""
graficar_GRATMA.py
==================
Grafica automáticamente los datos que guarda GRATMA_random.py, replicando las
4 gráficas del notebook `representar.ipynb`:

    1) Curvas FORWARD  (ida)      — todas las curvas superpuestas
    2) Curvas BACKWARD (vuelta)   — todas las curvas superpuestas
    3) Curva MEDIA ± desviación estándar (ida y vuelta)
    4) VIOLÍN con la distribución del punto de Dirac (mínimo Id) forward/backward

Busca de forma automática los ficheros limpios que genera GRATMA_random.py:

    Id_Vfg__<chip>_<sensor>_<info_extra>_GRATMA-<rep>.txt

que tienen separador ';' y columnas 'Vfg;Id;Ig;Is' (Vfg en voltios, Id en A).

Cómo elegir la carpeta (por orden de prioridad):
    1. Si le pasas una carpeta como argumento:  python graficar_GRATMA.py "C:\\GRATMA\\medidas"
    2. Si no, abre una ventana para que selecciones la carpeta.
    3. Si no hay ventana disponible, usa la variable CARPETA_POR_DEFECTO de abajo.

Guarda las figuras como PNG en una subcarpeta 'graficas' dentro de la carpeta
seleccionada y, si puede, las muestra por pantalla.

Ejecutar:
    python graficar_GRATMA.py
"""

import os
import re
import sys
import glob
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from matplotlib.ticker import ScalarFormatter


# ============================ CONFIGURACIÓN =============================
# Carpeta que se usa si no pasas argumento y no eliges nada en la ventana.
CARPETA_POR_DEFECTO = r"C:\GRATMA\medidas"

# Patrón de los ficheros a graficar. Por defecto: TODOS los sensores y reps.
#   - Todos:                 "Id_Vfg__*GRATMA*.txt"
#   - Solo la repetición 1:  "Id_Vfg__*GRATMA-1.txt"
PATRON_FICHEROS = "Id_Vfg__*GRATMA*.txt"

BUSCAR_EN_SUBCARPETAS = True   # busca también dentro de subcarpetas
GUARDAR_FIGURAS = True         # guarda cada gráfica como PNG
MOSTRAR_FIGURAS = True         # plt.show() al final (ignóralo si no hay pantalla)

# --- Estética (igual que tu notebook) ---
colormap_name = "tab10"
xlabel = "Gate Voltage (V)"
ylabel = "Drain Current (µA)"
ID_A_MICRO = 1e6               # Id está en amperios -> µA para representar

xlabel_fontsize = 22
ylabel_fontsize = 22
tick_size = 16
spine_width = 1.8

# Límites de los ejes. Deja None para que se ajusten solos a tus datos.
XLIM = None   # p.ej. (-0.2, 1.2)
YLIM = None   # p.ej. (50, 1650)
XLIM_DIRAC = None
# =======================================================================


# ------------------------- Estilo de los ejes --------------------------
def formatear_ejes(poner_titulos=True):
    """Marco completo, ticks hacia dentro en los 4 lados y números en negrita."""
    ax = plt.gca()
    ax.xaxis.set_ticks_position("both")
    ax.yaxis.set_ticks_position("both")
    ax.tick_params(axis="both", which="both", direction="in",
                   top=True, bottom=True, left=True, right=True,
                   length=6, width=1.5, labelsize=tick_size)
    for side in ["bottom", "top", "left", "right"]:
        ax.spines[side].set_visible(True)
        ax.spines[side].set_linewidth(spine_width)
    for label in ax.get_xticklabels() + ax.get_yticklabels():
        label.set_fontweight("bold")
    if poner_titulos:
        plt.xlabel(xlabel, fontsize=xlabel_fontsize, fontweight="bold", labelpad=12)
        plt.ylabel(ylabel, fontsize=ylabel_fontsize, fontweight="bold", labelpad=12)


# --------------------------- Lectura de datos --------------------------
def leer_txt(path):
    """
    Lee un fichero Id_Vfg de GRATMA (separador ';', columnas Vfg;Id;Ig;Is) y
    devuelve un DataFrame con columnas 'Vfg' (V) e 'Id' (A).

    Es tolerante: se salta la cabecera y cualquier línea que no sean números,
    admite coma o punto decimal, y también funciona si el fichero viniera
    separado por comas o espacios.
    """
    df = None
    for sep in [";", ",", r"\s+"]:
        try:
            tmp = pd.read_csv(path, sep=sep, header=None, comment="#",
                              engine="python", encoding="utf-8",
                              on_bad_lines="skip")
        except Exception:
            continue
        if tmp.shape[1] >= 2:
            df = tmp
            break
    if df is None:
        raise ValueError(f"No se pudo leer el fichero: {path}")

    df = df.iloc[:, :2]
    df.columns = ["Vfg", "Id"]
    for col in ["Vfg", "Id"]:
        df[col] = (df[col].astype(str).str.replace(",", ".", regex=False))
        df[col] = pd.to_numeric(df[col], errors="coerce")
    return df.dropna().reset_index(drop=True)


def separar_ida_vuelta(v, i):
    """
    Separa una curva en ida (forward) y vuelta (backward) usando el punto de
    máximo Vfg como vértice del barrido. Si no hay vuelta (barrido solo de ida)
    devuelve la vuelta vacía.
    """
    v = np.asarray(v, dtype=float)
    i = np.asarray(i, dtype=float)
    if len(v) < 3:
        return (v, i), (np.array([]), np.array([]))
    idx = int(np.argmax(v))                    # vértice del barrido
    v_ida, i_ida = v[:idx + 1], i[:idx + 1]
    v_vuelta, i_vuelta = v[idx + 1:], i[idx + 1:]
    if len(v_vuelta) < 3:                       # barrido solo de ida
        v_vuelta, i_vuelta = np.array([]), np.array([])
    return (v_ida, i_ida), (v_vuelta, i_vuelta)


def calcular_dirac(curvas_ida, curvas_vuelta):
    """Punto de Dirac (Vfg del mínimo Id) de cada curva."""
    dirac_forward, dirac_backward = [], []
    for (v, i) in curvas_ida:
        if len(v) > 0:
            dirac_forward.append(v[int(np.argmin(i))])
    for (v, i) in curvas_vuelta:
        if len(v) > 0:
            dirac_backward.append(v[int(np.argmin(i))])
    return dirac_forward, dirac_backward


# --------------------- Selección automática de carpeta -----------------
def elegir_carpeta():
    """1) argumento de la línea de comandos  2) ventana  3) por defecto."""
    if len(sys.argv) > 1 and os.path.isdir(sys.argv[1]):
        return sys.argv[1]
    try:
        import tkinter as tk
        from tkinter import filedialog
        root = tk.Tk()
        root.withdraw()
        root.attributes("-topmost", True)
        carpeta = filedialog.askdirectory(
            title="Elige la carpeta con los .txt de GRATMA")
        root.destroy()
        if carpeta:
            return carpeta
    except Exception:
        pass
    return CARPETA_POR_DEFECTO


def buscar_ficheros(carpeta):
    """Devuelve la lista ordenada de ficheros que cumplen el patrón."""
    if BUSCAR_EN_SUBCARPETAS:
        patron = os.path.join(carpeta, "**", PATRON_FICHEROS)
        ficheros = glob.glob(patron, recursive=True)
    else:
        ficheros = glob.glob(os.path.join(carpeta, PATRON_FICHEROS))
    return sorted(ficheros)


def guardar(fig_dir, nombre):
    if GUARDAR_FIGURAS:
        os.makedirs(fig_dir, exist_ok=True)
        ruta = os.path.join(fig_dir, nombre)
        plt.savefig(ruta, dpi=200, bbox_inches="tight")
        print(f"    Guardada: {ruta}")


# ------------------------------- MAIN ----------------------------------
def main():
    carpeta = elegir_carpeta()
    print("=" * 62)
    print(f"Carpeta: {carpeta}")
    print(f"Patrón : {PATRON_FICHEROS}")
    print("=" * 62)

    if not os.path.isdir(carpeta):
        print(f"❌ La carpeta no existe: {carpeta}")
        return

    ficheros = buscar_ficheros(carpeta)
    if not ficheros:
        print("⚠️  No se encontró ningún fichero que cumpla el patrón.")
        print("    Revisa PATRON_FICHEROS o la carpeta seleccionada.")
        return

    print(f"Se encontraron {len(ficheros)} ficheros:")
    for f in ficheros:
        print(f"  · {os.path.basename(f)}")

    # --- Leer y separar ida / vuelta ---
    curvas_ida, curvas_vuelta = [], []
    for f in ficheros:
        try:
            df = leer_txt(f)
        except Exception as e:
            print(f"  [WARN] no se pudo leer {os.path.basename(f)}: {e}")
            continue
        if len(df) < 3:
            continue
        v = df["Vfg"].values
        i = df["Id"].values * ID_A_MICRO           # A -> µA
        (v_i, i_i), (v_b, i_b) = separar_ida_vuelta(v, i)
        curvas_ida.append((v_i, i_i))
        if len(v_b) > 0:
            curvas_vuelta.append((v_b, i_b))

    n_ida = len(curvas_ida)
    n_vuelta = len(curvas_vuelta)
    print(f"\n✅ Curvas válidas: {n_ida} forward, {n_vuelta} backward.")
    if n_ida == 0:
        print("❌ No hay datos que graficar.")
        return

    fig_dir = os.path.join(carpeta, "graficas")
    try:                                   # compatible con varias versiones
        colors = plt.colormaps.get_cmap(colormap_name).resampled(max(n_ida, 1))
    except Exception:
        colors = plt.cm.get_cmap(colormap_name, max(n_ida, 1))

    # ---------- 1) Curvas Forward ----------
    plt.figure(figsize=(8, 5))
    for k, (v, i) in enumerate(curvas_ida):
        plt.plot(v, i, color=colors(k))
    plt.title(f"Forward curves ({n_ida} curvas)")
    if XLIM: plt.xlim(*XLIM)
    if YLIM: plt.ylim(*YLIM)
    formatear_ejes()
    plt.gca().yaxis.set_major_formatter(ScalarFormatter(useMathText=True))
    plt.gca().ticklabel_format(style="plain", axis="y")
    plt.tight_layout()
    guardar(fig_dir, "1_forward.png")

    # ---------- 2) Curvas Backward ----------
    if n_vuelta > 0:
        plt.figure(figsize=(8, 5))
        for k, (v, i) in enumerate(curvas_vuelta):
            plt.plot(v, i, color=colors(k))
        plt.title(f"Backward curves ({n_vuelta} curvas)")
        if XLIM: plt.xlim(*XLIM)
        if YLIM: plt.ylim(*YLIM)
        formatear_ejes()
        plt.gca().yaxis.set_major_formatter(ScalarFormatter(useMathText=True))
        plt.gca().ticklabel_format(style="plain", axis="y")
        plt.tight_layout()
        guardar(fig_dir, "2_backward.png")
    else:
        print("  [INFO] No hay curvas de vuelta (barridos solo de ida): "
              "se omiten las gráficas Backward y su media.")

    # ---------- 3) Media ± desviación estándar ----------
    # Rango común de Vfg tomado de los propios datos.
    v_min = min(np.min(v) for v, _ in curvas_ida)
    v_max = max(np.max(v) for v, _ in curvas_ida)
    common_x = np.linspace(v_min, v_max, 300)

    def interpolar(curvas):
        out = []
        for v, i in curvas:
            orden = np.argsort(v)
            out.append(np.interp(common_x, np.asarray(v)[orden],
                                 np.asarray(i)[orden]))
        return np.array(out)

    interp_ida = interpolar(curvas_ida)
    mean_ida, std_ida = interp_ida.mean(axis=0), interp_ida.std(axis=0)

    plt.figure(figsize=(9, 6))
    plt.plot(common_x, mean_ida, color="blue", label="Mean Forward")
    plt.fill_between(common_x, mean_ida - std_ida, mean_ida + std_ida,
                     color="blue", alpha=0.3)
    if n_vuelta > 0:
        interp_vuelta = interpolar(curvas_vuelta)
        mean_v, std_v = interp_vuelta.mean(axis=0), interp_vuelta.std(axis=0)
        plt.plot(common_x, mean_v, color="red", label="Mean Backward")
        plt.fill_between(common_x, mean_v - std_v, mean_v + std_v,
                         color="red", alpha=0.3)
    if XLIM: plt.xlim(*XLIM)
    if YLIM: plt.ylim(*YLIM)
    formatear_ejes()
    ax = plt.gca()
    for tick in ax.get_xticklabels() + ax.get_yticklabels():
        tick.set_fontsize(20); tick.set_fontweight("bold")
    ax.yaxis.set_major_formatter(ScalarFormatter(useMathText=True))
    ax.ticklabel_format(style="plain", axis="y")
    leg = plt.legend(fontsize=22, frameon=False)
    for text in leg.get_texts():
        text.set_fontweight("bold")
    plt.tight_layout()
    guardar(fig_dir, "3_media_std.png")

    # ---------- 4) Violín del punto de Dirac ----------
    dirac_forward, dirac_backward = calcular_dirac(curvas_ida, curvas_vuelta)
    data, labels, cols = [], [], []
    if dirac_backward:
        data.append(dirac_backward); labels.append("Backward"); cols.append("red")
    if dirac_forward:
        data.append(dirac_forward); labels.append("Forward"); cols.append("blue")

    if data:
        plt.figure(figsize=(8, 4))
        posiciones = list(range(1, len(data) + 1))
        parts = plt.violinplot(data, positions=posiciones, vert=False,
                               showmeans=False, showextrema=False,
                               showmedians=False)
        for idx, pc in enumerate(parts["bodies"]):
            pc.set_facecolor(cols[idx]); pc.set_edgecolor(cols[idx])
            pc.set_alpha(0.3)
        for yi, arr in zip(posiciones, data):
            med = np.median(arr)
            plt.plot([med, med], [yi - 0.3, yi + 0.3],
                     color=cols[yi - 1], linewidth=2)
        for yi, arr in zip(posiciones, data):
            y_j = np.random.normal(yi, 0.04, size=len(arr))
            plt.scatter(arr, y_j, color=cols[yi - 1], alpha=0.9)
        plt.yticks(posiciones, labels, fontsize=22, fontweight="bold")
        plt.xlabel(r"$\mathbf{V}_{\mathbf{Dirac}}\ \mathbf{(V)}$", fontsize=24)
        if XLIM_DIRAC: plt.xlim(*XLIM_DIRAC)
        ax = plt.gca()
        ax.tick_params(direction="in", length=6, width=1.5, which="both",
                       top=True, bottom=True, left=True, right=True)
        for tick in ax.get_xticklabels():
            tick.set_fontweight("bold"); tick.set_fontsize(18)
        for tick in ax.get_yticklabels():
            tick.set_fontweight("bold")
        for spine in ax.spines.values():
            spine.set_linewidth(2.2)
        plt.tight_layout()
        guardar(fig_dir, "4_dirac_violin.png")

    if MOSTRAR_FIGURAS:
        try:
            plt.show()
        except Exception:
            pass
    print("\n\033[1mHecho\033[0m")


if __name__ == "__main__":
    main()
